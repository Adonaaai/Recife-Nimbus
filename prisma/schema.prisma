generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================
//  GEOGRAPHIC HIERARCHY
// ==========================================

model City {
  id            Int            @id @default(autoincrement())
  name          String         @unique // e.g., "Recife", "Jaboatão dos Guararapes"
  
  zones         Zone[]
  channelAlerts CityAlertLog[]  // ← ADD THIS
}

model CityAlertLog {
  id              Int      @id @default(autoincrement())
  cityId          Int
  
  // Which zones alerted in this city (JSON or list)
  alertedZones    String   // e.g., "North Zone, Center Zone" or JSON
  hasRedAlert     Boolean  // TRUE if at least one zone had RED
  
  // Consolidated data
  severity        String   // "RED" or "YELLOW"
  messageSent     String   // Full text sent to channel
  triggeredAt     DateTime @default(now())
  
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}


model Zone {
  id               Int            @id @default(autoincrement())
  name             String         @unique // e.g., "Zona Sul", "Zona Norte"
  isCoastal        Boolean        @default(false) // True if the zone has a coastline (for tide data)
  
  // Center point for 3-Hour Forecasts (Open-Meteo)
  latitude         Float          
  longitude        Float          
  
  // The "Keys" to unlock the APAC Real-Time APIs 
  rainSensorNames  String[]       // e.g., ["[CEMADEN] Piedade", "[CEMADEN] Prazeres"]
  riverBasins      String[]       // e.g., ["GL2", "Capibaribe"]
  
  cityId           Int
  city             City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  
  neighborhoods    Neighborhood[]
  alerts           AlertLog[]
}

model Neighborhood {
  id            Int            @id @default(autoincrement())
  name          String         // e.g., "Boa Viagem", "Imbiribeira"
  
  zoneId        Int
  zone          Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  users         User[]
  @@unique([name, zoneId])
}

// ==========================================
//  USERS & NOTIFICATIONS
// ==========================================

model User {
  id             Int          @id @default(autoincrement())
  telegramChatId String       @unique
  name           String
  
  // The user subscribes to a specific neighborhood, but the bot 
  // calculates danger based on the Zone that neighborhood belongs to.
  neighborhoodId Int?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  isActive       Boolean @default(true)

  createdAt      DateTime     @default(now())
}

// ==========================================
//  ALERT HISTORY & LOGS
// ==========================================

model AlertLog {
  id            Int      @id @default(autoincrement())
  zoneId        Int      
  
  // The Triple-Threat Data at the exact moment of the alert
  rainLevel      Float?   // Real-time from APAC (or forecast amount)
  tideLevel      Float?   // From Tide API/PDF
  forecastTide   Float?
  forecastRainMm Float?  // Predicted rain (Open-Meteo) at alert time
  riverLevel     String?  // APAC River Status (e.g., "Normal", "Alerta", "Inundação")
  riverTendencia String? // "S" | "M" | "D"
  
  // Metadata about the alert
  severity      String   // e.g., "YELLOW" (Predictive), "RED" (Real-Time Critical)
  messageSent   String   // The exact text sent to the Telegram users
  triggeredAt   DateTime @default(now())

  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}